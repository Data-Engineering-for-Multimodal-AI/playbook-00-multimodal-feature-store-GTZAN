# All optional; the defaults match mmfeaturestore/docker-compose.yml.
POSTGRES_USER=featurestore_user
POSTGRES_PASSWORD=featurestore
POSTGRES_DB=featurestore
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
